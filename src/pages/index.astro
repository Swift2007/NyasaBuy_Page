---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Categories from "../components/Categories.astro";
import Sell from "../components/Sell.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---
<Layout description="Shop phones, fashion, groceries and home goods from trusted sellers across Malawi. Pay with Airtel Money, TNM Mpamba or card.">
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="page-frame">
    <Header />
    <main id="main">
      <Hero />
      <Showcase />
      <HowItWorks />
      <Categories />
      <Sell />
      <Faq />
      <FinalCta />
    </main>
    <Footer />
  </div>

  <script is:inline>
    // Mobile menu toggle: aria-expanded stays the source of truth and the
    // .menu-open class drives the grid-rows drawer animation in the header.
    const menuBtn = document.querySelector("[data-menu-toggle]");
    const menuHeader = menuBtn ? menuBtn.closest(".site-header") : null;
    if (menuBtn && menuHeader) {
      const setMenu = (open) => {
        menuBtn.setAttribute("aria-expanded", String(open));
        menuHeader.classList.toggle("menu-open", open);
      };

      menuBtn.addEventListener("click", () => {
        setMenu(menuBtn.getAttribute("aria-expanded") !== "true");
      });

      // Picking a destination closes the drawer so the page shows through.
      menuHeader.querySelectorAll(".mobile-link").forEach((link) => {
        link.addEventListener("click", () => setMenu(false));
      });

      // Escape closes the open mobile menu and returns focus to the toggle.
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menuBtn.getAttribute("aria-expanded") === "true") {
          setMenu(false);
          menuBtn.focus();
        }
      });
    }

    // ARIA tabs pattern: roving tabindex, selection follows focus on
    // Left/Right/Home/End; each tab's aria-controls matches its panel id.
    const tablist = document.querySelector('[role="tablist"]');
    if (tablist) {
      const tabs = Array.from(tablist.querySelectorAll('[role="tab"]'));
      const panels = tabs.flatMap((tab) => {
        const panel = document.getElementById(tab.getAttribute("aria-controls"));
        return panel ? [panel] : [];
      });
      if (panels.length === tabs.length) {
        let current = 0;
        const select = (index) => {
          current = index;
          tabs.forEach((tab, i) => {
            const active = i === index;
            tab.setAttribute("aria-selected", String(active));
            tab.tabIndex = active ? 0 : -1;
            panels[i].classList.toggle("is-active", active);
          });
        };

        // Auto-rotate: the showcase advances itself every AUTO_ROTATE_MS and
        // loops through the tabs forever. Off entirely for reduced-motion
        // users, and paused while the pointer is over the panel or something
        // in it has focus — it resumes as soon as interaction ends.
        const AUTO_ROTATE_MS = 3000;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const showcase = tablist.closest(".showcase");
        let rotateTimer = null;
        let hoverPaused = false;
        let focusPaused = false;
        const stopRotate = () => {
          if (rotateTimer) {
            clearInterval(rotateTimer);
            rotateTimer = null;
          }
        };
        const startRotate = () => {
          if (reducedMotion.matches || hoverPaused || focusPaused || rotateTimer) return;
          rotateTimer = setInterval(() => select((current + 1) % tabs.length), AUTO_ROTATE_MS);
        };

        tabs.forEach((tab, i) => {
          tab.addEventListener("click", () => {
            select(i);
            // Keep the loop going: drop the old countdown and start a fresh
            // one so the next auto-advance is a full AUTO_ROTATE_MS away.
            stopRotate();
            startRotate();
          });
          tab.addEventListener("keydown", (event) => {
            let next = null;
            if (event.key === "ArrowRight") next = (i + 1) % tabs.length;
            else if (event.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
            else if (event.key === "Home") next = 0;
            else if (event.key === "End") next = tabs.length - 1;
            if (next !== null) {
              event.preventDefault();
              select(next);
              tabs[next].focus();
            }
          });
        });

        if (showcase) {
          showcase.addEventListener("mouseenter", () => {
            hoverPaused = true;
            stopRotate();
          });
          showcase.addEventListener("mouseleave", () => {
            hoverPaused = false;
            startRotate();
          });
          showcase.addEventListener("focusin", () => {
            focusPaused = true;
            stopRotate();
          });
          showcase.addEventListener("focusout", () => {
            focusPaused = false;
            startRotate();
          });
        }
        startRotate();
      }
    }

    // One-shot scroll reveal: each .reveal block fades and rises once as it
    // enters the viewport, then stops being observed. The CSS side is gated
    // on html.js-motion, so without JS the blocks simply render visible.
    const reveals = document.querySelectorAll(".reveal");
    if (reveals.length) {
      if ("IntersectionObserver" in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in-view");
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -8% 0px" }
        );
        reveals.forEach((el) => revealObserver.observe(el));
      } else {
        // No observer support: skip the effect rather than hide content.
        reveals.forEach((el) => el.classList.add("in-view"));
      }
    }
  </script>
</Layout>
