---
// Showcase: four ARIA-tabbed feature cards on a flat light field.
// Only interactivity: tab switching (script lives in src/pages/index.astro).
---

<section class="showcase reveal">
  <div class="tabs" role="tablist" aria-label="Explore NyasaBuy">
    <button
      class="tab"
      type="button"
      id="tab-shopping"
      role="tab"
      aria-selected="true"
      aria-controls="panel-shopping"
    >
      <span class="visually-hidden">Shopping</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5.5 8.5h13l-1 11.5h-11z" />
        <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" />
      </svg>
    </button>
    <button
      class="tab"
      type="button"
      id="tab-payments"
      role="tab"
      aria-selected="false"
      aria-controls="panel-payments"
      tabindex="-1"
    >
      <span class="visually-hidden">Payments</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5.5" width="18" height="13" rx="2" />
        <path d="M3 10h18" />
        <path d="M6.5 15h4" />
      </svg>
    </button>
    <button
      class="tab"
      type="button"
      id="tab-sellers"
      role="tab"
      aria-selected="false"
      aria-controls="panel-sellers"
      tabindex="-1"
    >
      <span class="visually-hidden">Sellers</span>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 9.5 5.2 5h13.6L20 9.5" />
        <path d="M4 9.5h16" />
        <path d="M5.5 9.5v9h13v-9" />
        <path d="M10 18.5v-4.5h4v4.5" />
      </svg>
    </button>
  </div>

  <div class="panes">
    <div class="pane is-active" id="panel-shopping" role="tabpanel" aria-labelledby="tab-shopping">
      <article class="panel-card">
        <div class="panel-copy">
          <p class="panel-label"><span class="label-dot" style="background:#339E35;"></span>Shopping</p>
          <h2>Find what you need in seconds</h2>
          <p class="panel-text">
            Search thousands of listings and jump straight to what you need with
            smart categories and saved shops.
          </p>
        </div>
        <div class="panel-visual">
          <img class="phone-shot" src="/images/showcase/01_shopping.webp" alt="Home screen with featured and recent listings" width="560" height="906" loading="lazy" />
        </div>
      </article>
    </div>

    <div class="pane" id="panel-payments" role="tabpanel" aria-labelledby="tab-payments">
      <article class="panel-card">
        <div class="panel-copy">
          <p class="panel-label"><span class="label-dot" style="background:#CE1126;"></span>Payments</p>
          <h2>Pay the way you already do</h2>
          <p class="panel-text">
            Check out with the methods Malawians trust.
          </p>
        </div>
        <div class="panel-visual">
          <img class="phone-shot" src="/images/showcase/02_payments.webp" alt="Buy now sheet with pickup or delivery and a pay button" width="560" height="906" loading="lazy" />
        </div>
      </article>
    </div>

    <div class="pane" id="panel-delivery" role="tabpanel" aria-labelledby="tab-delivery">
      <article class="panel-card">
        <div class="panel-copy">
          <p class="panel-label"><span class="label-dot" style="background:#2563EB;"></span>Delivery</p>
          <h2>Track your order to your door</h2>
          <p class="panel-text">
            Live status updates from the shop to your doorstep, with a driver you
            can rely on.
          </p>
        </div>
        <div class="panel-visual">
          <img class="phone-shot" src="/images/showcase/03_delivery.webp" alt="Orders screen tracking an order from payment to delivery" width="560" height="906" loading="lazy" />
        </div>
      </article>
    </div>

    <div class="pane" id="panel-sellers" role="tabpanel" aria-labelledby="tab-sellers">
      <article class="panel-card">
        <div class="panel-copy">
          <p class="panel-label"><span class="label-dot" style="background:#1E3A8A;"></span>Sellers</p>
          <h2>Open your shop on NyasaBuy</h2>
          <p class="panel-text">
            List products in minutes and manage orders, payouts and customers
            from one dashboard.
          </p>
        </div>
        <div class="panel-visual">
          <img class="phone-shot" src="/images/showcase/04_sellers.webp" alt="Seller dashboard with balance and sales stats" width="560" height="906" loading="lazy" />
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .showcase {
    border-radius: var(--r-panel);
    padding: clamp(1.5rem, 4vw, 2.75rem) clamp(1.25rem, 3.5vw, 2.5rem) clamp(1.75rem, 4.5vw, 3rem);
    overflow: hidden;
    /* Flat light field matching the final CTA ("Ready to start shopping?"). */
    background: var(--chip);
  }

  .tabs {
    display: flex;
    justify-content: center;
    gap: 0.625rem;
    margin-bottom: 1.625rem;
  }

  /* Non-text contrast (WCAG 1.4.11): near-white icons on the glassy tile
     measured ~1.2:1 because the tabs sit on the mesh's light top edge. Dark
     icons on a stronger glass surface pull the icon to ~7.4:1 and make the
     tile itself read as a control; the default navy focus outline now also
     works here, so the old white-outline override is gone. */
  .tab {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid rgba(13, 27, 51, 0.08);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.6);
    color: rgba(13, 27, 51, 0.78);
    cursor: pointer;
  }

  .tab:hover {
    background: rgba(255, 255, 255, 0.72);
  }

  .tab[aria-selected="true"] {
    background: var(--accent);
    color: var(--white);
  }

  /* Rounded notch bridging the active tab down to the card. */
  .tab[aria-selected="true"]::after {
    content: "";
    position: absolute;
    bottom: -12px;
    left: 50%;
    width: 16px;
    height: 16px;
    transform: translateX(-50%) rotate(45deg);
    border-radius: 4px;
    background: var(--accent);
  }

  .panes {
    display: grid;
  }

  /* Panes stack in one grid cell so the cross-fade never shifts layout.
     The inactive pane sits 8px low: it rises into place while fading in
     and sinks back on the way out, so enter and exit share one path. */
  .pane {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
  }

  .pane.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Sequential dissolve: the outgoing pane fades and sinks away quickly,
       then the incoming pane rises into place on a short delay. The stagger
       keeps two screens from ghosting over each other mid-change. */
    .pane {
      transition:
        opacity 160ms ease,
        transform 160ms var(--ease-out),
        visibility 0s linear 160ms;
    }

    .pane.is-active {
      transition:
        opacity 220ms ease 160ms,
        transform 220ms var(--ease-out) 160ms;
    }
  }

  .panel-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
    padding: clamp(1.375rem, 3.5vw, 2.25rem);
    background: var(--white);
    border-radius: 24px;
    box-shadow: 0 24px 60px -24px rgba(13, 27, 51, 0.45);
  }

  .panel-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--body);
  }

  .label-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .panel-copy h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.375rem, 2.4vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .panel-text {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--body);
  }

  .phone-shot {
    display: block;
    width: 100%;
    max-width: 260px;
    height: auto;
    aspect-ratio: 560 / 906;
    object-fit: cover;
    object-position: top;
    border-radius: 22px;
    border: 6px solid var(--navy);
    box-shadow: 0 14px 34px -16px rgba(13, 27, 51, 0.45);
  }

  .panel-visual {
    display: flex;
    justify-content: center;
    padding: clamp(1.125rem, 2.5vw, 1.75rem);
    border-radius: 20px;
    background: var(--chip);
  }

  /* ——— Shared mock-UI pieces (decorative, aria-hidden) ——— */

  .app-card {
    width: 100%;
    max-width: 300px;
    padding: 1.125rem;
    background: var(--white);
    border-radius: 16px;
    box-shadow: 0 14px 34px -16px rgba(13, 27, 51, 0.35);
  }

  .mock-heading {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--navy);
  }

  .mock-btn {
    display: block;
    margin-top: 0.75rem;
    padding: 0.625rem 1rem;
    border-radius: var(--r-btn);
    background: var(--navy);
    color: var(--white);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  /* Shopping mock */
  .mock-search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid #E3E9F2;
    border-radius: 10px;
    background: var(--white);
  }

  .mock-search-text {
    font-size: 0.8125rem;
    color: #9AA5BC;
  }

  .mock-chip-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.625rem;
  }

  .mock-chip {
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: var(--chip);
    color: var(--accent-deep);
    font-size: 0.6875rem;
    font-weight: 600;
  }

  .mock-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .mock-tile {
    display: grid;
    gap: 0.2rem;
    padding: 0.5rem;
    border-radius: 10px;
    background: #FAFBFD;
  }

  .thumb {
    height: 32px;
    border-radius: 6px;
  }

  .mock-tile .name {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--navy);
  }

  .mock-tile .price {
    font-size: 0.625rem;
    color: var(--body);
  }

  /* Payments mock */
  .pay-option {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 0.625rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid #EDF1F7;
    border-radius: 10px;
  }

  .pay-option.is-selected {
    border-color: var(--accent);
    background: var(--chip);
  }

  .pay-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--navy);
  }

  .radio {
    width: 14px;
    height: 14px;
    margin-left: auto;
    border: 1.5px solid #C3CCDC;
    border-radius: 50%;
  }

  .is-selected .radio {
    border-color: var(--accent);
    background: var(--accent);
  }

  .pay-total {
    display: flex;
    justify-content: space-between;
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid #EDF1F7;
    font-size: 0.8125rem;
    color: var(--body);
  }

  .pay-total strong {
    color: var(--navy);
  }

  /* Delivery mock */
  .mock-map {
    border-radius: 12px;
    background: var(--chip);
    overflow: hidden;
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 0.875rem 0 0;
  }

  .timeline li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0 0.375rem 1.25rem;
    font-size: 0.8125rem;
    color: var(--navy);
  }

  .timeline li + li::before {
    content: "";
    position: absolute;
    top: -0.5rem;
    left: 5px;
    height: 0.9rem;
    width: 1.5px;
    background: #E0E6F0;
  }

  .tl-dot {
    position: absolute;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #C3CCDC;
  }

  .tl-done .tl-dot {
    background: var(--navy);
  }

  .tl-active .tl-dot {
    background: var(--accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.22);
  }

  .tl-active {
    color: var(--accent);
    font-weight: 600;
  }

  .tl-pending {
    color: #9AA5BC;
  }

  .tl-time {
    margin-left: auto;
    font-size: 0.6875rem;
    color: var(--body);
  }

  .mock-note {
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid #EDF1F7;
    font-size: 0.75rem;
    color: var(--body);
  }

  /* Sellers mock */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .stat {
    display: grid;
    gap: 0.15rem;
    padding: 0.5rem 0.625rem;
    border-radius: 10px;
    background: #FAFBFD;
  }

  .stat-label {
    font-size: 0.625rem;
    color: var(--body);
  }

  .stat-value {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--navy);
    white-space: nowrap;
  }

  .app-card .mock-heading {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
  }

  .order-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.375rem 0;
    border-top: 1px solid #F1F4F9;
  }

  .avatar {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 0.5625rem;
    font-weight: 700;
    color: var(--navy);
  }

  .order-name {
    font-size: 0.75rem;
    color: var(--navy);
  }

  .status {
    margin-left: auto;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    font-size: 0.625rem;
    font-weight: 600;
  }

  .chip-paid {
    background: #E9F6EC;
    color: #227A31;
  }

  .chip-posted {
    background: #E6EEFC;
    color: var(--accent-deep);
  }

  .chip-shipped {
    background: #EEF1F6;
    color: var(--body);
  }

  @media (max-width: 819px) {
    .panel-card {
      grid-template-columns: 1fr;
    }
  }
</style>
