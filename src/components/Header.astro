---
// Top navbar: recreated brand mark, primary nav, and auth actions.
---

<header class="site-header">
  <div class="header-row">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <!-- Recreated NyasaBuy cart: black/red/green stripes fill the basket, navy outline + wheels -->
        <svg viewBox="0 0 24 24" width="22" height="22" role="img" aria-hidden="true">
          <path d="M2.6 4.2h2.5l1.6 3.1" fill="none" stroke="#1E3A8A" stroke-width="1.5" stroke-linecap="round" />
          <path d="M6.7 7.3h13.9l-1.9 6.2H8.5z" fill="none" stroke="#1E3A8A" stroke-width="1.5" stroke-linejoin="round" />
          <rect x="8.3" y="8" width="11.7" height="1.5" fill="#000000" />
          <rect x="8.55" y="9.75" width="11.1" height="1.3" fill="#CE1126" />
          <rect x="9.15" y="11.35" width="10.1" height="1.3" fill="#339E35" />
          <circle cx="10.4" cy="17.6" r="1.55" fill="#1E3A8A" />
          <circle cx="17.2" cy="17.6" r="1.55" fill="#1E3A8A" />
        </svg>
      </span>
      <span class="brand-name">NyasaBuy</span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <a class="nav-link" href="#categories">Categories</a>
      <a class="nav-link" href="#sell">Sell with us</a>
      <a class="nav-link" href="#faq">Help</a>
    </nav>

    <div class="header-actions">
      <a class="contact-link" href="#cta">Contact us</a>
      <a class="get-app-link" href="#get-app">Get app</a>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" fill="none" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Primary mobile">
    <!-- .mobile-nav-clip is the animated grid row; .mobile-nav-links clips the
         overflow while the row grows, so links slide out instead of jumping. -->
    <div class="mobile-nav-clip">
      <div class="mobile-nav-links">
        <a class="mobile-link" href="#categories">Categories</a>
        <a class="mobile-link" href="#sell">Sell with us</a>
        <a class="mobile-link" href="#faq">Help</a>
        <a class="mobile-link" href="#cta">Contact us</a>
        <a class="mobile-link mobile-link-get-app" href="#get-app">Get app</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid #EEF1F6;
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    /* Less headroom, but keep the lower padding so the row still sits clear
       of the divider line beneath it. */
    padding: 0.5rem 0 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #DEEBF7;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    color: var(--navy);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.375rem;
    margin-right: auto;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--navy-hover);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--r-btn);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    color: var(--navy);
    border: 1.5px solid var(--navy);
    transition: background-color 150ms ease, border-color 150ms ease, transform 130ms var(--ease-out);
  }

  .contact-link:hover {
    background: #F1F4F9;
  }

  .get-app-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.65rem 1.25rem;
    border-radius: var(--r-btn);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    background: var(--navy);
    color: var(--white);
    transition: background-color 150ms ease, transform 130ms var(--ease-out);
  }

  .get-app-link:hover {
    background: var(--navy-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact-link:active {
      transform: scale(0.97);
    }

    .get-app-link:active {
      transform: scale(0.97);
    }
  }

  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid #D8DEE9;
    border-radius: 10px;
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, transform 130ms var(--ease-out);
  }

  .menu-btn:hover {
    background: #F1F4F9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-btn:active {
      transform: scale(0.95);
    }
  }

  /* Mobile menu popup: floats below the pressed menu button, anchored to the
     right edge where the toggle lives. Appears as a floating panel rather
     than a full-width drawer. */
  .mobile-nav {
    display: none;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    width: 240px;
    background: var(--white);
    border: 1px solid #E5E7EB;
    border-radius: 12px;
    box-shadow: 0 10px 25px -5px rgba(13, 27, 51, 0.1),
      0 8px 10px -6px rgba(13, 27, 51, 0.05);
    padding: 0.5rem;
    z-index: 50;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.92) translateY(-6px);
    pointer-events: none;
    transition: opacity 150ms ease, transform 150ms ease,
      visibility 150ms ease;
  }

  .menu-open .mobile-nav {
    opacity: 1;
    visibility: visible;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .mobile-link {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    transition: background-color 120ms ease;
  }

  .mobile-link:hover {
    background: #F1F4F9;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav,
    .menu-open .mobile-nav {
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .main-nav {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 559px) {
    .contact-link {
      display: none;
    }

    .btn {
      padding: 0.55rem 0.85rem;
    }
  }
</style>
