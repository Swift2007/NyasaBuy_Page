---
// Top navbar: recreated brand mark, primary nav, and auth actions.
---

<header class="site-header">
  <div class="header-row">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <!-- Recreated NyasaBuy cart: black/red/green stripes fill the basket, navy outline + wheels -->
        <svg viewBox="0 0 24 24" width="22" height="22" role="img" aria-hidden="true">
          <path d="M2.6 4.2h2.5l1.6 3.1" fill="none" stroke="#1E3A8A" stroke-width="1.5" stroke-linecap="round" />
          <path d="M6.7 7.3h13.9l-1.9 6.2H8.5z" fill="none" stroke="#1E3A8A" stroke-width="1.5" stroke-linejoin="round" />
          <rect x="8.3" y="8" width="11.7" height="1.5" fill="#000000" />
          <rect x="8.55" y="9.75" width="11.1" height="1.3" fill="#CE1126" />
          <rect x="9.15" y="11.35" width="10.1" height="1.3" fill="#339E35" />
          <circle cx="10.4" cy="17.6" r="1.55" fill="#1E3A8A" />
          <circle cx="17.2" cy="17.6" r="1.55" fill="#1E3A8A" />
        </svg>
      </span>
      <span class="brand-name">NyasaBuy</span>
    </a>

    <nav class="main-nav" aria-label="Primary">
      <a class="nav-link" href="#categories">Categories<svg class="chev" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      <a class="nav-link" href="#sell">Sell with us<svg class="chev" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      <a class="nav-link" href="#faq">Help<svg class="chev" viewBox="0 0 10 10" width="10" height="10" aria-hidden="true"><path d="M2 3.5 5 6.5 8 3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
      <a class="nav-link" href="#">Deals</a>
    </nav>

    <div class="header-actions">
      <a class="contact-link" href="#cta">Contact us</a>
      <a class="btn btn-solid" href="#">Get started for free</a>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <span class="visually-hidden">Open menu</span>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" fill="none" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Primary mobile">
    <!-- .mobile-nav-clip is the animated grid row; .mobile-nav-links clips the
         overflow while the row grows, so links slide out instead of jumping. -->
    <div class="mobile-nav-clip">
      <div class="mobile-nav-links">
        <a class="mobile-link" href="#categories">Categories</a>
        <a class="mobile-link" href="#sell">Sell with us</a>
        <a class="mobile-link" href="#faq">Help</a>
        <a class="mobile-link" href="#">Deals</a>
        <a class="mobile-link" href="#cta">Contact us</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .site-header {
    border-bottom: 1px solid #EEF1F6;
  }

  .header-row {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    /* Less headroom, but keep the lower padding so the row still sits clear
       of the divider line beneath it. */
    padding: 0.5rem 0 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: #DEEBF7;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    color: var(--navy);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.375rem;
    margin-right: auto;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--navy-hover);
  }

  .chev {
    color: var(--body);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }

  .contact-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
  }

  .contact-link:hover {
    color: var(--navy-hover);
  }

  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1.5px solid #D8DEE9;
    border-radius: 10px;
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, transform 130ms var(--ease-out);
  }

  .menu-btn:hover {
    background: #F1F4F9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-btn:active {
      transform: scale(0.95);
    }
  }

  /* Mobile drawer: hidden at desktop widths; on small screens it lives in the
     flow as a 0fr grid row that grows to 1fr when .menu-open is set on the
     header, so it animates open and closed instead of toggling display. */
  .mobile-nav {
    display: none;
  }

  .mobile-nav-clip {
    display: grid;
    grid-template-rows: 0fr;
  }

  .mobile-nav-links {
    overflow: hidden;
    min-height: 0;
    padding: 0.25rem 0 0.75rem;
    visibility: hidden;
  }

  .menu-open .mobile-nav-clip {
    grid-template-rows: 1fr;
  }

  /* Visibility flips instantly on open, and only after the row finishes
     collapsing on close, so the links stay reachable mid-animation. */
  .menu-open .mobile-nav-links {
    visibility: visible;
  }

  .mobile-link {
    padding: 0.625rem 0.25rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    border-top: 1px solid #F1F4F9;
  }

  @media (prefers-reduced-motion: no-preference) {
    .js-motion .mobile-nav-clip {
      transition: grid-template-rows 280ms var(--ease-out);
    }

    .js-motion .mobile-nav-links {
      transition: visibility 0s linear 280ms;
    }

    .js-motion .menu-open .mobile-nav-links {
      transition: visibility 0s;
    }
  }

  @media (max-width: 899px) {
    .main-nav {
      display: none;
    }

    .menu-btn {
      display: inline-flex;
    }

    .mobile-nav {
      display: block;
    }
  }

  @media (max-width: 559px) {
    .contact-link {
      display: none;
    }

    .btn {
      padding: 0.55rem 0.85rem;
    }
  }
</style>
