---
// Small line icons for the guide cards. Decorative: the card text says it all.
interface Props {
  name: "bag" | "store" | "shield" | "truck" | "person" | "help";
}

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {name === "bag" && (<><path d="M5 8h14l-1 11H6L5 8Z" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8" /></>)}
  {name === "store" && (<><path d="M4 9.5 5.5 5h13L20 9.5" /><path d="M4 9.5a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0" /><path d="M5.5 12.5V19h13v-6.5" /></>)}
  {name === "shield" && (<><path d="M12 3.5 5 6v5.5c0 4.2 2.9 7.2 7 9 4.1-1.8 7-4.8 7-9V6l-7-2.5Z" /><path d="m9 12 2.2 2.2L15.5 10" /></>)}
  {name === "truck" && (<><path d="M3 6.5h10V16H3z" /><path d="M13 9.5h4l3 3V16h-7z" /><circle cx="7" cy="17.5" r="1.6" /><circle cx="16.5" cy="17.5" r="1.6" /></>)}
  {name === "person" && (<><circle cx="12" cy="8.5" r="3.5" /><path d="M5 19.5c.8-3.3 3.4-5 7-5s6.2 1.7 7 5" /></>)}
  {name === "help" && (<><circle cx="12" cy="12" r="8.5" /><path d="M9.7 9.6a2.4 2.4 0 1 1 3.4 2.2c-.7.4-1.1.9-1.1 1.7" /><path d="M12 16.6v.1" /></>)}
</svg>
