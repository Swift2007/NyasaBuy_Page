---
// A numbered walk-through: each step has a short title and a sentence or two.
interface Props {
  items: { title: string; body: string }[];
}

const { items } = Astro.props;
---

<ol class="steps-list">
  {items.map((step, i) => (
    <li>
      <span class="num" aria-hidden="true">{i + 1}</span>
      <div class="text">
        <h3>{step.title}</h3>
        <p>{step.body}</p>
      </div>
    </li>
  ))}
</ol>

<style>
  .steps-list {
    display: grid;
    gap: 0.875rem;
    margin: 1.125rem 0 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.875rem;
    align-items: start;
    padding: 1rem 1.125rem;
    border-radius: var(--r-card);
    background: #FAFBFD;
  }

  .num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  h3 {
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  p {
    margin: 0.25rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--body);
  }
</style>
