---
// "In this guide": jump links to each section, so a long guide is easy to scan.
interface Props {
  items: { id: string; label: string }[];
}

const { items } = Astro.props;
---

<nav class="guide-jump" aria-label="In this guide">
  <ul>
    {items.map((item) => (
      <li><a href={`#${item.id}`}>{item.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .guide-jump {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 0 clamp(1rem, 3vw, 1.5rem);
  }

  .guide-jump ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .guide-jump a {
    display: inline-block;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--chip);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--navy);
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .guide-jump a:hover {
    background: #DEEBF7;
  }
</style>
