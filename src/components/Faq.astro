---
// FAQ: native details/summary accordion — no JS. name="faq" keeps only one
// item open in browsers that support the exclusive-accordion attribute.
const faqs = [
  {
    q: "Do I need a card or bank account to shop?",
    a: "No. Create an account with your phone number and pay at checkout with Airtel Money, TNM Mpamba or any bank card. Shop freely either way.",
  },
  {
    q: "How does delivery work?",
    a: "The seller packs, and NyasaBuy-approved drivers deliver. You follow the order from pickup to your door with live status updates. Delivery fees show before you pay.",
  },
  {
    q: "Is it free to open a shop on NyasaBuy?",
    a: "Yes, signing up is free. You only pay a commission on an order once it is delivered — no listing fees, no monthly subscriptions.",
  },
  {
    q: "When do I receive my money?",
    a: "Earnings for delivered orders are paid to your Airtel Money or TNM Mpamba wallet on your payout schedule. You can see exactly what cleared in your seller dashboard.",
  },
];
---

<section class="faq" id="faq" aria-labelledby="faq-heading">
  <div class="section-head">
    <h2 id="faq-heading">Frequently asked questions</h2>
    <p class="section-intro">The quick answers most people need before their first order.</p>
  </div>

  <div class="faq-list">
    {faqs.map((f, i) => (
      <details class="faq-item" name="faq" open={i === 0}>
        <summary>
          <span class="faq-q">{f.q}</span>
          <svg class="faq-chevron" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m3 6.5 5 4.5 5-4.5" /></svg>
        </summary>
        <p class="faq-a">{f.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq {
    padding: clamp(2.25rem, 6vw, 4rem) 0;
  }

  .section-head {
    text-align: center;
  }

  .section-head h2 {
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    font-weight: 700;
    line-height: 1.15;
  }

  .section-intro {
    max-width: 540px;
    margin: 0.75rem auto 0;
    font-size: 1rem;
    color: var(--body);
  }

  .faq-list {
    max-width: 760px;
    margin: clamp(1.5rem, 3vw, 2.25rem) auto 0;
    display: grid;
    gap: 0.625rem;
  }

  .faq-item {
    padding: 1rem 1.25rem;
    border: 1px solid #EEF1F6;
    border-radius: var(--r-card);
    background: var(--white);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
  }

  /* Hide the native disclosure triangle: list-style covers Gecko/Chromium,
     ::-webkit-details-marker covers Safari. */
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-size: 1rem;
    font-weight: 600;
    color: var(--navy);
    line-height: 1.4;
  }

  .faq-chevron {
    flex-shrink: 0;
  }

  /* Open state flips the chevron with a plain transform — the page ships with zero motion. */
  .faq-item[open] .faq-chevron {
    transform: rotate(180deg);
  }

  .faq-a {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    color: var(--body);
  }
</style>
