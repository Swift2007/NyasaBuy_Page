---
// Hero: two-line headline, app download CTAs, and the browse footnote.
---

<section class="hero">
  <h1 class="hero-title reveal">
    Everything you need,<br class="hero-br" /> delivered across Malawi.
  </h1>
  <p class="hero-copy reveal" style="--reveal-delay: 70ms">
    From phones and fashion to groceries and home goods, shop trusted sellers and
    pay with Airtel Money, TNM Mpamba or card.
  </p>

  <div class="hero-actions reveal" style="--reveal-delay: 140ms">
    <a class="btn btn-solid btn-big" id="open-app" href="https://app.nyasabuy.com">Continue in the browser</a>
    <span class="btn btn-outline btn-soon" aria-disabled="true">Mobile app coming soon</span>
  </div>
</section>

<script is:inline>
  // Warm the browser cache with the Flutter web app while the visitor reads
  // this page, so "Continue in the browser" opens fast. app.nyasabuy.com is
  // the same site as this one, so the cache is shared. The bundle is ~12MB:
  // it is only fetched when idle on a decent connection, or on first intent
  // (hover, focus, touch) otherwise.
  (function () {
    var BASE = "https://app.nyasabuy.com/";
    var FILES = [
      "main.dart.js",
      "canvaskit/canvaskit.js",
      "canvaskit/canvaskit.wasm",
      "flutter_bootstrap.js",
    ];
    var done = false;
    function warm() {
      if (done) return;
      done = true;
      FILES.forEach(function (f) {
        var l = document.createElement("link");
        l.rel = "prefetch";
        l.href = BASE + f;
        document.head.appendChild(l);
      });
    }
    var c = navigator.connection || {};
    var ok = !c.saveData && !/(^|-)2g$/.test(c.effectiveType || "");
    var btn = document.getElementById("open-app");
    if (btn) {
      ["pointerenter", "focus", "touchstart"].forEach(function (e) {
        btn.addEventListener(e, warm, { once: true, passive: true });
      });
    }
    if (ok) {
      var idle = window.requestIdleCallback || function (fn) { setTimeout(fn, 2500); };
      window.addEventListener("load", function () { idle(warm, { timeout: 4000 }); });
    }
  })();
</script>

<style>
  .hero {
    max-width: 780px;
    margin: 0 auto;
    padding: clamp(2.5rem, 7vw, 5rem) 0 clamp(2.75rem, 7vw, 4.5rem);
    text-align: center;
  }

  .hero-title {
    font-size: clamp(42px, 5.5vw, 64px);
    font-weight: 700;
    line-height: 1.08;
  }

  .hero-copy {
    max-width: 620px;
    margin: 1.25rem auto 0;
    font-size: 1.0625rem;
    color: var(--body);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn-big {
    padding: 1.125rem 2.5rem;
    font-size: 1.1875rem;
    min-width: min(100%, 20rem);
  }

  .btn-soon {
    cursor: default;
    opacity: 0.75;
    pointer-events: none;
  }

  /* Below ~660px the forced break no longer fits two 42px lines, so the
     headline wraps naturally instead. */
  @media (max-width: 659px) {
    .hero-br {
      display: none;
    }
  }
</style>
