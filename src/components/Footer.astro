---
// Footer: navy site footer inside the page frame — brand row, link columns,
// payments line, legal row.
---

<footer class="footer" aria-label="Footer">
  <div class="footer-top">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <!-- Header cart in the inverted treatment: white outline and wheels,
             black/red/green basket stripes kept in color. -->
        <svg viewBox="0 0 24 24" width="22" height="22" role="img" aria-hidden="true">
          <path d="M2.6 4.2h2.5l1.6 3.1" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" />
          <path d="M6.7 7.3h13.9l-1.9 6.2H8.5z" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linejoin="round" />
          <rect x="8.3" y="8" width="11.7" height="1.5" fill="#000000" />
          <rect x="8.55" y="9.75" width="11.1" height="1.3" fill="#CE1126" />
          <rect x="9.15" y="11.35" width="10.1" height="1.3" fill="#339E35" />
          <circle cx="10.4" cy="17.6" r="1.55" fill="#FFFFFF" />
          <circle cx="17.2" cy="17.6" r="1.55" fill="#FFFFFF" />
        </svg>
      </span>
      <span class="brand-name">NyasaBuy</span>
    </a>
    <p class="tagline">Let the market find you</p>
  </div>

  <div class="link-columns">
    <nav aria-label="Shop">
      <h3>Shop</h3>
      <ul>
        <li><a href="#categories">Phones &amp; electronics</a></li>
        <li><a href="#categories">Fashion</a></li>
        <li><a href="#categories">Groceries &amp; food</a></li>
        <li><a href="#categories">Home &amp; kitchen</a></li>
      </ul>
    </nav>
    <nav aria-label="Sell">
      <h3>Sell</h3>
      <ul>
        <li><a href="#sell">Open your shop</a></li>
        <li><a href="#sell">Seller tools</a></li>
        <li><a href="#how-it-works">Delivery help</a></li>
      </ul>
    </nav>
    <nav aria-label="Support">
      <h3>Support</h3>
      <ul>
        <li><a href="#cta">Contact us</a></li>
        <li><a href="#faq">Help centre</a></li>
        <li><a href="#faq">FAQ</a></li>
      </ul>
    </nav>
  </div>

  <p class="payments">
    Pay with Airtel Money <span class="sep" aria-hidden="true">•</span> TNM
    Mpamba <span class="sep" aria-hidden="true">•</span> Visa
  </p>

  <div class="footer-bottom">
    <p>© 2026 NyasaBuy. All rights reserved.</p>
    <p>Made for Malawi</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    padding: clamp(2rem, 5vw, 3rem);
    border-radius: var(--r-frame);
    background: var(--navy);
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  /* Same tile geometry as the header mark, lightened for the dark footer. */
  .brand-mark {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.08);
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    color: var(--white);
  }

  .tagline {
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(222, 235, 247, 0.8);
  }

  /* Auto-fit grid: three columns on desktop, wraps on narrow screens. */
  .link-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.75rem 1.25rem;
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .link-columns h3 {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.6);
  }

  .link-columns ul {
    margin-top: 0.75rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .link-columns a {
    font-size: 0.9375rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .link-columns a:hover {
    color: #DEEBF7;
  }

  .payments {
    margin-top: clamp(1.5rem, 4vw, 2rem);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .sep {
    margin: 0 0.4em;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: clamp(1.25rem, 3.5vw, 1.75rem);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* The global outline is navy, which vanishes on this panel. */
  .footer :focus-visible {
    outline-color: #fff;
  }
</style>
