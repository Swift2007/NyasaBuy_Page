---
// Footer: compact navy footer — brand and the real section links share one
// row, then payments and the legal line. Only sections that exist on the page
// are linked; shelf-level links were dropped because category pages do not
// exist yet, and "Visa" became "Card" to match the page's own payment copy.
---

<footer class="footer" aria-label="Footer">
  <div class="footer-top">
    <a class="brand" href="/">
      <span class="brand-name">NyasaBuy</span>
    </a>

    <nav class="footer-nav" aria-label="Site sections">
      <a href="#categories">Categories</a>
      <a href="#how-it-works">How it works</a>
      <a href="#sell">Sell with us</a>
      <a href="#faq">FAQ</a>
      <a href="#cta">Contact us</a>
    </nav>
  </div>

  <p class="payments">
    Pay with Airtel Money <span class="sep" aria-hidden="true">•</span> TNM
    Mpamba <span class="sep" aria-hidden="true">•</span> Card
  </p>

  <div class="footer-bottom">
    <p>© 2026 NyasaBuy. All rights reserved.</p>
    <p>Made for Malawi</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: clamp(1.25rem, 3vw, 2rem);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border-radius: var(--r-frame);
    background: var(--navy);
  }

  .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.03em;
    color: var(--white);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1.375rem;
  }

  .footer-nav a {
    font-size: 0.9375rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
  }

  .footer-nav a:hover {
    color: #DEEBF7;
  }

  .payments {
    margin-top: clamp(1.25rem, 3vw, 1.75rem);
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .sep {
    margin: 0 0.4em;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  /* The global outline is navy, which vanishes on this panel. */
  .footer :focus-visible {
    outline-color: #fff;
  }
</style>
