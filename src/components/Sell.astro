---
// Sell: navy conversion block — tagline eyebrow, seller CTAs and the trust note.

<section class="sell" aria-labelledby="sell-heading">
  <p class="sell-eyebrow">Let the market find you</p>
  <h2 id="sell-heading">Turn your shop into an online store</h2>
  <p class="sell-copy">
    List your products in minutes, keep your regulars, and reach buyers across
    Malawi. Payments and delivery tracking are built in — Airtel Money, TNM
    Mpamba and card are handled for you.
  </p>

  <div class="sell-actions">
    <a class="btn btn-light" href="#">Create your free shop</a>
    <a class="btn btn-ghost" href="#">See seller tools</a>
  </div>

  <p class="sell-note">
    Free sign-up <span class="note-sep" aria-hidden="true">•</span> Commission
    only when you sell <span class="note-sep" aria-hidden="true">•</span> MWK
    payouts
  </p>
</section>

<style>
  .sell {
    padding: clamp(2.25rem, 6vw, 3.5rem);
    border-radius: var(--r-frame);
    background: var(--navy);
    text-align: center;
  }

  .sell-eyebrow {
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.72);
  }

  .sell h2 {
    margin-top: 0.75rem;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1.15;
    color: var(--white);
  }

  .sell-copy {
    max-width: 560px;
    margin: 1rem auto 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }

  .sell-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Dark-panel button variants reuse the shared .btn geometry from global.css. */
  .btn-light {
    background: var(--white);
    color: var(--navy);
  }

  .btn-light:hover {
    background: #E9EEF7;
  }

  .btn-ghost {
    background: transparent;
    border-color: rgba(255, 255, 255, 0.35);
    color: var(--white);
  }

  .btn-ghost:hover {
    background: rgba(255, 255, 255, 0.08);
  }

  /* The global focus outline is navy, which vanishes against this panel. */
  .btn-light:focus-visible,
  .btn-ghost:focus-visible {
    outline-color: var(--white);
  }

  .sell-note {
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .note-sep {
    margin: 0 0.4em;
  }
</style>
